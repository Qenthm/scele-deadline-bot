# Copy this file to .env.local for local testing (never commit .env.local).
# In production these are set with `vercel env add <NAME>`.

# SCELE (Moodle) login
SCELE_BASE_URL=https://scele.cs.ui.ac.id
SCELE_USERNAME=
SCELE_PASSWORD=

# Comma-separated list of courses to watch. Each item is either:
#   - a numeric course id (the ?id=NNNN in a course/view.php URL) — exact match, or
#   - a name/code substring, case-insensitive, matched against full name + short name.
# Run `npm run list-courses` to see your enrolled courses and their ids.
MONITORED_COURSES=

# How many days ahead to look for due dates.
DEADLINE_WINDOW_DAYS=14

# Optional: also watch every course page (pages, files, links, not just items with a due
# date) for MONITORED_COURSES, and ping on any addition/rename/removal. Only used by
# `npm run check:diff`. Set to "false" to disable.
WATCH_COURSE_CONTENT=true

# Discord webhook to post the report to. Leave blank to only print to stdout.
DISCORD_WEBHOOK_URL=

# Optional: your Discord user id (enable Developer Mode in Discord settings, then
# right-click your name -> Copy User ID). If set, every message pings you.
DISCORD_USER_ID=

# Optional: required for the deployed /api/check-deadlines cron endpoint.
# Vercel sends this automatically as `Authorization: Bearer <CRON_SECRET>`
# when it's set, so only Vercel's own cron trigger can invoke the endpoint.
CRON_SECRET=
